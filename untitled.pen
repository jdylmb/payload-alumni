                        {
                          "type": "text",
                          "id": "GbZL5",
                          "name": "Feat News Desc",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Visayas State University celebrates 100 years of academic excellence with a grand alumni homecoming, bringing together generations of Viscans for a historic reunion filled with nostalgia, camaraderie, and pride.",
