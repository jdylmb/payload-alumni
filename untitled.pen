                        {
                          "type": "text",
                          "id": "M1q0jl",
                          "name": "Mission P1",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The Alumni & Community Relations Office (ACRO) serves as the vital link between Visayas State University and its growing network of graduates. Established to strengthen bonds and foster lifelong connections, ACRO facilitates alumni registration, ID processing, and chapter coordination across the Philippines and abroad.",
                          "lineHeight": 1.7,
                          "fontFamily": "$font-body",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "ZoKik",
                          "name": "Mission P2",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Through strategic programs, events, and outreach initiatives, we empower alumni to give back — whether through mentorship, scholarships, career guidance, or direct contributions to university development. ACRO is committed to making every Viscan feel connected, valued, and proud of their alma mater.",
                          "lineHeight": 1.7,
                          "fontFamily": "$font-body",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
