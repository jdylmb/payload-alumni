                          "fontFamily": "$font-heading",
                          "fontSize": 30,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "rqmTM",
                          "name": "Vision P1",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "We envision ACRO as the premier alumni relations office in the Visayas region — a model of excellence in building and sustaining meaningful connections between graduates and their university. Our goal is a worldwide network of engaged Viscans who actively participate in the growth of VSU.",
                          "lineHeight": 1.7,
                          "fontFamily": "$font-body",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "hw0OJ",
                          "name": "Vision P2",
                          "fill": "$text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "By fostering a culture of giving, collaboration, and shared purpose, we aim to transform alumni engagement into a powerful force for educational advancement, community development, and institutional pride.",
                          "lineHeight": 1.7,
                          "fontFamily": "$font-body",
                          "fontSize": 14,
                          "fontWeight": "normal"
